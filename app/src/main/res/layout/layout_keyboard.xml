<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- Wingman AI Toolbar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/kbBtnOpener"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="@color/surface_variant"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="✨ Opener"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/kbBtnTease"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/surface_variant"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="🌶️ Tease"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/kbBtnDate"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/primary"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="🎯 Date Closer"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/kbBtnCasual"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/surface_variant"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="💬 Make Casual"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/kbBtnSwitchIme"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/surface"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="⌨️ Regular Keyboard"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- AI Suggestion / Input Area -->
    <TextView
        android:id="@+id/kbTvSuggestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:padding="10dp"
        android:text="Tap an AI button above to auto-type into chat..."
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <Button
        android:id="@+id/kbBtnInsert"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:backgroundTint="@color/primary"
        android:text="Insert into Chat"
        android:textColor="@color/white"
        android:visibility="gone" />

</LinearLayout>
